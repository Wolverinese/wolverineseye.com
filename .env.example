# Configuration for the shox-backed policy gate (see PHASE_1.md, lib/policy/client.ts).
# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Base URL of the shox router, e.g. https://shox.internal
SHOX_BASE_URL=

# Auth token issued to webi3-website for policy gate calls to shox.
SHOX_POLICY_API_KEY=
